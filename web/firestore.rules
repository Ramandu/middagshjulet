rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hver husstand ligger under households/{husstands-ID}/docs/{dokument}.
    // «lp3» er ukeplan og handleliste regnet ut for Light Phone-verktøyet.
    // Husstands-ID-en er en lang, tilfeldig kode i lenken. Den som har lenken, har tilgang.
    // Det er ikke lov å liste opp husstander, så man kan ikke finne andres planer uten lenken.
    match /households/{hid}/docs/{docId} {
      allow get: if request.auth != null && hid.size() >= 20;
      allow create, update: if request.auth != null
        && hid.size() >= 20
        && docId in ['setup', 'log', 'plan', 'basis', 'w0', 'w1', 'w2', 'w3', 'lp3']
        && request.resource.data.keys().size() < 40;
      allow list, delete: if false;
    }
    // Alt annet er stengt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
